generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model TypeUser {
  typeUserId Int     @id @default(autoincrement()) @map("type_user_id")
  name       String  @db.VarChar(80)
  active     Boolean @default(true)
  users      User[]  @relation("UserTypeUser")

  @@map("tb_type_user")
}

model User {
  userId                   Int                   @id @default(autoincrement()) @map("user_id")
  email                    String                @unique @db.VarChar(250)
  name                     String                @db.VarChar(150)
  password                 String                @db.VarChar(80)
  registeredAt             DateTime              @default(now()) @map("registered_at") @db.Timestamp(0)
  typeUserId               Int                   @map("type_user_id")
  active                   Boolean               @default(true)
  chats                    Chat[]
  authoredDocuments        Document[]            @relation("DocumentAuthor")
  authoredDocumentVersions DocumentVersion[]     @relation("DocumentVersionAuthor")
  messages                 Message[]
  permissionGroupUsers     PermissionGroupUser[]
  sharedChats              SharedChat[]
  typeUser                 TypeUser              @relation("UserTypeUser", fields: [typeUserId], references: [typeUserId])

  @@index([email])
  @@index([typeUserId])
  @@map("tb_user")
}

model Department {
  departmentId               Int                         @id @default(autoincrement()) @map("department_id")
  departmentNm               String                      @map("department_nm") @db.VarChar(100)
  acronym                    String                      @unique @db.VarChar(5)
  active                     Boolean                     @default(true)
  documentDepartments        DocumentDepartment[]
  permissionGroupDepartments PermissionGroupDepartment[]

  @@map("tb_department")
}

model System {
  systemId               Int                     @id @default(autoincrement()) @map("system_id")
  systemNm               String                  @map("system_nm") @db.VarChar(80)
  active                 Boolean                 @default(true)
  acronym                String                  @unique @db.VarChar(5)
  documentSystems        DocumentSystem[]
  permissionGroupSystems PermissionGroupSystem[]

  @@map("tb_system")
}

model Document {
  documentId          String               @id(map: "tb_file_pkey") @default(uuid()) @map("document_id") @db.Uuid
  title               String?              @db.VarChar(150)
  autorId             Int                  @map("autor_id")
  active              Boolean              @default(true)
  lastVersionId       String?              @map("last_version_id") @db.Uuid
  lastUpdateAt        DateTime             @default(now()) @map("last_update_at") @db.Timestamp(6)
  autor               User                 @relation("DocumentAuthor", fields: [autorId], references: [userId], map: "tb_file_autor_id_fkey")
  documentDepartments DocumentDepartment[]
  documentSystems     DocumentSystem[]
  versions            DocumentVersion[]    @relation("DocumentVersions")

  @@index([autorId], map: "tb_file_autor_id_idx")
  @@map("tb_document")
}

model DocumentVersion {
  documentVersionId String          @unique(map: "tb_document_version_unique") @default(uuid()) @map("document_version_id") @db.Uuid
  documentId        String          @map("document_id") @db.Uuid
  version           String          @db.VarChar(10)
  hash              String          @db.VarChar(80)
  documentPath      String          @map("document_path")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamp(6)
  active            Boolean         @default(true)
  status            DocumentStatus? @default(PROCESSING)
  autorId           Int             @map("autor_id")
  document          Document        @relation("DocumentVersions", fields: [documentId], references: [documentId], onDelete: NoAction, onUpdate: NoAction, map: "tb_document_version_tb_document_fk")
  autor             User            @relation("DocumentVersionAuthor", fields: [autorId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "tb_document_version_tb_user_fk")

  @@map("tb_document_version")
}

model DocumentSystem {
  systemId   Int      @map("system_id")
  documentId String   @map("document_id") @db.Uuid
  document   Document @relation(fields: [documentId], references: [documentId], map: "tb_file_system_file_id_fkey")
  system     System   @relation(fields: [systemId], references: [systemId], map: "tb_file_system_system_id_fkey")

  @@id([systemId, documentId], map: "tb_file_system_pkey")
  @@map("tb_document_system")
}

model DocumentDepartment {
  documentId   String     @map("document_id") @db.Uuid
  departmentId Int        @map("department_id")
  department   Department @relation(fields: [departmentId], references: [departmentId], map: "tb_file_department_department_id_fkey")
  document     Document   @relation(fields: [documentId], references: [documentId], map: "tb_file_department_file_id_fkey")

  @@id([documentId, departmentId], map: "tb_file_department_pkey")
  @@map("tb_document_department")
}

model Chat {
  chatId       String       @id @default(uuid()) @map("chat_id") @db.Uuid
  title        String       @db.VarChar(100)
  userId       Int          @map("user_id")
  createdAt    DateTime?    @map("created_at") @db.Timestamp(6)
  lastUpdateAt DateTime?    @map("last_update_at") @db.Timestamp(6)
  user         User         @relation(fields: [userId], references: [userId])
  messages     Message[]
  sharedChats  SharedChat[]

  @@map("tb_chat")
}

model RoleChat {
  roleChatId  Int          @id @map("role_chat_id")
  roleChatNm  String       @map("role_chat_nm") @db.VarChar(80)
  active      Boolean      @default(true)
  sharedChats SharedChat[]

  @@map("tb_role_chat")
}

model SharedChat {
  chatId     String   @map("chat_id") @db.Uuid
  userId     Int      @map("user_id")
  roleChatId Int      @map("role_chat_id")
  chat       Chat     @relation(fields: [chatId], references: [chatId])
  roleChat   RoleChat @relation(fields: [roleChatId], references: [roleChatId])
  user       User     @relation(fields: [userId], references: [userId])

  @@id([chatId, userId])
  @@map("tb_shared_chat")
}

model Message {
  messageId    String         @id @default(uuid()) @map("message_id") @db.Uuid
  chatId       String         @map("chat_id") @db.Uuid
  messageText  String         @map("message_text")
  sendAt       DateTime       @map("send_at") @db.Timestamp(0)
  userId       Int?           @map("user_id")
  modelIaId    Int?           @map("model_ia_id")
  status       MessageStatus? @default(PROCESSING)
  fileMessages FileMessage[]
  chat         Chat           @relation(fields: [chatId], references: [chatId])
  modelIa      ModelIa?       @relation(fields: [modelIaId], references: [modelIaId], onDelete: NoAction, onUpdate: NoAction, map: "tb_message_tb_model_ia_fk")
  user         User?          @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction, map: "tb_message_tb_user_fk")
  tokenHistory TokenHistory?

  @@index([messageText])
  @@index([chatId])
  @@map("tb_message")
}

model FileMessage {
  fileId    String   @id @default(uuid()) @map("file_id") @db.Uuid
  filePath  String   @map("file_path") @db.VarChar(255)
  messageId String   @map("message_id") @db.Uuid
  sendDt    DateTime @map("send_dt") @db.Timestamp(0)
  message   Message  @relation(fields: [messageId], references: [messageId])

  @@index([messageId])
  @@map("tb_file_message")
}

model ModelIa {
  modelIaId   Int          @id @default(autoincrement()) @map("model_ia_id")
  modelNm     String       @map("model_nm") @db.VarChar(100)
  chatModel   String       @unique @map("chat_model") @db.VarChar(100)
  active      Boolean      @default(true)
  messages    Message[]
  modelIaKeys ModelIaKey[]

  @@map("tb_model_ia")
}

model ModelIaKey {
  modelIaId Int     @map("model_ia_id")
  modelKey  String  @map("model_key") @db.Text
  qtnToken  Decimal @map("qtn_token") @db.Decimal(16, 2)
  active    Boolean @default(true)
  modelIa   ModelIa @relation(fields: [modelIaId], references: [modelIaId])

  @@id([modelIaId, modelKey])
  @@map("tb_model_ia_key")
}

model TokenHistory {
  messageId        String   @id @map("message_id") @db.Uuid
  amountTokenSpent Decimal  @map("amount_token_spent") @db.Decimal(8, 2)
  registerDt       DateTime @map("register_dt") @db.Timestamp(0)
  message          Message  @relation(fields: [messageId], references: [messageId])

  @@map("tb_token_history")
}

model PermissionGroup {
  permissionGroupId          Int                         @id @default(autoincrement()) @map("permission_group_id")
  permissionGroupNm          String                      @map("permission_group_nm") @db.VarChar(100)
  active                     Boolean                     @default(true)
  permissionGroupDepartments PermissionGroupDepartment[]
  permissionGroupSystems     PermissionGroupSystem[]
  permissionGroupUsers       PermissionGroupUser[]

  @@map("tb_permission_group")
}

model PermissionGroupUser {
  permissionGroupId Int             @map("permission_group_id")
  userId            Int             @map("user_id")
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [permissionGroupId])
  user              User            @relation(fields: [userId], references: [userId])

  @@id([permissionGroupId, userId])
  @@map("tb_permission_group_user")
}

model PermissionGroupDepartment {
  permissionGroupId Int             @map("permission_group_id")
  departmentId      Int             @map("department_id")
  department        Department      @relation(fields: [departmentId], references: [departmentId])
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [permissionGroupId])

  @@id([permissionGroupId, departmentId])
  @@map("tb_permission_group_department")
}

model PermissionGroupSystem {
  permissionGroupId Int             @map("permission_group_id")
  systemId          Int             @map("system_id")
  permissionGroup   PermissionGroup @relation(fields: [permissionGroupId], references: [permissionGroupId])
  system            System          @relation(fields: [systemId], references: [systemId])

  @@id([permissionGroupId, systemId])
  @@map("tb_permission_group_system")
}

enum DocumentStatus {
  PROCESSING
  DONE
  ERROR

  @@map("document_status")
}

enum MessageStatus {
  PROCESSING
  DONE
  ERROR

  @@map("message_status")
}
